{
  "name": "durable-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./telemetry": {
      "development": "./src/telemetry.ts",
      "types": "./dist/src/telemetry.d.ts",
      "default": "./dist/src/telemetry.js"
    },
    "./graphql": {
      "development": "./graphql/src/index.ts",
      "types": "./dist/graphql/src/index.d.ts",
      "default": "./dist/graphql/src/index.js"
    },
    "./graphql/schema.graphql": "./graphql/schema.graphql",
    "./watch": {
      "development": "./watch/watch.ts",
      "types": "./dist/watch/watch.d.ts",
      "default": "./dist/watch/watch.js"
    },
    "./serve": {
      "development": "./serve/serve.ts",
      "types": "./dist/serve/serve.d.ts",
      "default": "./dist/serve/serve.js"
    }
  },
  "files": [
    "dist",
    "graphql/schema.graphql"
  ],
  "scripts": {
    "build": "npm run build:graphql && tsc -p tsconfig.build.json",
    "check": "npm run build:graphql && tsc -p tsconfig.json && KNIP_DISABLE_RAW_TRANSFER=1 knip",
    "test": "c8 node --conditions=development --test \"tests/*.test.ts\" \"graphql/tests/*.test.ts\" \"serve/serve.test.ts\"",
    "build:graphql": "mkdir -p graphql/src/generated && grats --tsconfig graphql/tsconfig.grats.json && tsc -p graphql/tsconfig.grats.json"
  },
  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@earendil-works/pi-telemetry": "1.4.0",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/core": "2.12.0",
    "typebox": "1.3.27"
  },
  "peerDependencies": {
    "graphql": "16.14.2"
  },
  "devDependencies": {
    "@opentelemetry/exporter-metrics-otlp-http": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace": "2.12.0",
    "@types/node": "24.19.2",
    "c8": "12.0.0",
    "graphql": "16.14.2",
    "grats": "0.0.37",
    "knip": "6.44.1"
  },
  "c8": {
    "all": true,
    "include": [
      "src/**/*.ts",
      "graphql/src/index.ts",
      "graphql/src/graphql.ts",
      "watch/watch.ts",
      "serve/serve.ts"
    ],
    "extension": [
      ".ts"
    ],
    "reporter": [
      "text",
      "json-summary",
      "lcovonly",
      "html"
    ],
    "check-coverage": true,
    "lines": 100,
    "branches": 100,
    "functions": 100,
    "statements": 100
  },
  "knip": {
    "entry": [
      "tests/*.test.ts",
      "graphql/src/generated/graphql.ts",
      "graphql/**/*.test.ts",
      "serve/serve.test.ts"
    ],
    "project": [
      "src/**/*.ts!",
      "tests/**/*.ts",
      "graphql/**/*.ts",
      "watch/**/*.ts",
      "serve/**/*.ts"
    ],
    "typescript": {
      "config": [
        "tsconfig.json"
      ]
    },
    "ignoreBinaries": [
      "tsc"
    ]
  }
}
