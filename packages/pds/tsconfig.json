{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "DOM"],
    "module": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noEmitOnError": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "rewriteRelativeImportExtensions": true,
    "customConditions": ["development"],
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "bench/index.ts",
    "tests/**/*.ts",
    "tests/*.chromium.ts",
    "test-utils/**/*.ts"
  ]
}
