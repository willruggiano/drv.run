+    #[test]
+    fn test_orphan_reset_does_not_reset_reused_port() {
+        const LOCAL_PORT: u32 = 8888;
+        const PEER_PORT: u32 = 1023;
+        let mut ctx = MuxerTestContext::new("orphan_reset_reused_port");
+
+        ctx.init_pkt(LOCAL_PORT, PEER_PORT, uapi::VSOCK_OP_RST);
+        ctx.send();
+        assert!(!ctx.muxer.has_pending_rx());
+
+        let mut listener = ctx.create_local_listener(LOCAL_PORT);
+        ctx.init_pkt(LOCAL_PORT, PEER_PORT, uapi::VSOCK_OP_REQUEST);
+        ctx.send();
+        let _stream = listener.accept();
+        ctx.recv();
+        assert_eq!(ctx.pkt.op(), uapi::VSOCK_OP_RESPONSE);
+        assert!(!ctx.muxer.has_pending_rx());
+    }
